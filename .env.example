# Finny — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Gmail MCP ──────────────────────────────────────────────
GMAIL_ADDRESS=          # your Gmail address
GMAIL_APP_PASSWORD=    # 16-char app password from myaccount.google.com/apppasswords
GMAIL_LABEL_DBS=            # exact label name in Gmail e.g. "finny/dbs"
GMAIL_LABEL_SCAPIA=         # e.g. "Scapia"
GMAIL_LABEL_AXIS=           # e.g. "Axis Atlas"
GMAIL_LABEL_IXIGO=          # e.g. "Ixigo" (AU Bank credit card)

# ── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # from BotFather
TELEGRAM_CHAT_ID=           # your personal chat ID

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=               # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=       # service_role secret (not anon key)
DATABASE_URL=               # postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres

# ── App ────────────────────────────────────────────────────
TZ=Asia/Singapore           # critical — all date logic runs in SGT

# ── Dashboard: MCP server + iOS API (set these in Vercel) ──
FINNY_AUTH_SECRET=          # 32+ random chars: openssl rand -hex 32. Rotating it signs everyone out.
FINNY_OWNER_PASSWORD=       # the password you type when Claude / ChatGPT / the iOS app connects
FINNY_PUBLIC_URL=           # optional, e.g. https://finny.vercel.app. Pins the OAuth issuer to one domain
