# Finny — Environment Variables
# Copy this to .env and fill in your values
# Never commit .env to version control

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Gmail MCP ──────────────────────────────────────────────
GMAIL_MCP_URL=https://gmail.mcp.claude.com/mcp
GMAIL_MCP_TOKEN=
# Gmail label IDs (get from Gmail API or label settings URL)
GMAIL_LABEL_DBS=
GMAIL_LABEL_SCAPIA=
GMAIL_LABEL_AXIS=

# ── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # from BotFather
TELEGRAM_CHAT_ID=          # your personal chat ID (send /start to your bot, check logs)

# ── Database ───────────────────────────────────────────────
# Dev:  sqlite:./finny.db
# Prod: postgresql://user:pass@host:5432/finny
DATABASE_URL=sqlite:./finny.db

# ── App ────────────────────────────────────────────────────
TZ=Asia/Singapore           # critical — all date logic runs in SGT
NODE_ENV=development
